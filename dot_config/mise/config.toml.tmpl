# Shared developer toolchain for macOS and Linux development machines. This
# file is ignored unless the chezmoi `devMachine` profile is enabled.
# Repositories remain responsible for exact runtime pins through mise.toml,
# .node-version, .nvmrc, or package.json's devEngines/packageManager fields.

[tools]
node = "24"
pnpm = "latest"
# Shell integrations sourced by ~/.zshrc. Homebrew owns the same tools on
# macOS; Mise keeps their Linux installation declarative and versioned too.
starship = "latest"
fzf = "latest"
direnv = "latest"
zoxide = "latest"
"npm:@openai/codex" = "latest"
# These agent CLIs download their platform-native binaries from postinstall.
# Permit those reviewed packages to run lifecycle scripts during mise installs.
# Other packages and project pnpm installs keep their normal script policy.
"npm:@anthropic-ai/claude-code" = { version = "latest", allow_builds = ["@anthropic-ai/claude-code"] }
"npm:t3" = "latest"
"npm:opencode-ai" = { version = "latest", allow_builds = ["opencode-ai"] }

[settings]
# package.json remains the source of truth when a repository pins pnpm.
idiomatic_version_file_enable_tools = ["node", "pnpm"]

[settings.npm]
package_manager = "pnpm"
