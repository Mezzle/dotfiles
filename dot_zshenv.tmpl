# Silence zoxide's doctor false-positive in re-sourced/non-interactive shells
# (e.g. Claude Code's Bash tool). Set here in .zshenv so it is in the environment
# before `zoxide init` runs in .zshrc, in every shell type. Interactive use is fine.
export _ZO_DOCTOR=0

# rustup owns this file, not chezmoi, so it is absent until rustup has run.
if [ -f "${HOME}/.cargo/env" ]; then
    . "${HOME}/.cargo/env"
fi

# ~/.local/bin holds tools that install themselves outside Homebrew: chezmoi (from
# install.sh), ~/.local/bin/gpg-restart, and the `claude` symlink the Claude Code
# native installer maintains. That installer appends this same line to ~/.zshrc, but
# chezmoi owns that file and rewrites it on every apply, so it has to live here.
export PATH="${HOME}/.local/bin:${PATH}"
{{ if .devMachine }}
# Non-interactive shells never source .zshrc, so nub goes on PATH here as well.
# ~/.zshrc.d/99-nub.zsh re-seats all three dirs at the front for interactive shells,
# where .zshrc prepends ${BREW_PREFIX}/bin after this file has run.
# ~/.nub/shims holds the npm/pnpm/yarn shims: `nub pm` provisions the exact package
# manager each project pins via packageManager and runs it on the project's Node
# (corepack's job), refusing to run a package manager the project does not pin.
export PATH="${HOME}/.nub/bin:${HOME}/.nub/node-shim:${HOME}/.nub/shims:${PATH}"

# Netskope (Chemist4U's SWG) TLS-inspects some upstreams with a private root CA.
# curl/browsers trust it via the macOS keychain, but Node.js ships its own CA
# bundle and ignores the keychain -- so pnpm/node/cdk/tsx fail with
# SELF_SIGNED_CERT_IN_CHAIN on inspected hosts (e.g. pkg-npm.githubusercontent.com,
# the GitHub Packages download CDN). run_onchange_before_04-export-netskope-ca.sh
# exports the CA from the System keychain; point Node at it when it is present.
if [ -f "${HOME}/.certs/netskope-ca.pem" ]; then
    export NODE_EXTRA_CA_CERTS="${HOME}/.certs/netskope-ca.pem"
fi
{{- end }}
