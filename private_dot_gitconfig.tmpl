[user]
  name = {{ .name | quote  }}
  email = {{ .email | quote }}
{{- if .signGitCommits }}
  signingkey = {{ .signingKey }}
{{- end }}
[github]
  user = Mezzle
[color]
  diff = auto
  status = auto
  branch = auto
  ui = true
[alias]
  co = checkout
  ff = pull --ff-only
  st = status
[push]
  default = simple
[core]
  excludesfile = ~/.gitignore_global
  autocrlf = input
[rerere]
  enabled = true
[init]
  defaultBranch = main
[pull]
  ff = only
{{- if eq .chezmoi.hostname "Cube" }}
# Cube is driven remotely by agents, where nobody can approve a 1Password SSH
# prompt. Send GitHub git traffic over HTTPS so the gh credential helper below
# authenticates with the keychain token instead.
[url "https://github.com/"]
  insteadOf = git@github.com:
  insteadOf = ssh://git@github.com/
{{- else }}
[url "ssh://git@github.com/Mezzle"]
  insteadOf = https://github.com/Mezzle
[url "ssh://git@github.com/sane-defaults"]
  insteadOf = https://github.com/sane-defaults
[url "ssh://git@github.com/Debian"]
  insteadOf = https://github.com/Debian
[url "ssh://git@github.com/Flamboyant-Potato"]
  insteadOf = https://github.com/Flamboyant-Potato
[url "ssh://git@github.com/GamerPowered"]
  insteadOf = https://github.com/GamerPowered
[url "ssh://git@github.com/Majimez"]
  insteadOf = https://github.com/Majimez
{{- if .work }}
[url "ssh://git@github.com/chemist4u"]
  insteadOf = https://github.com/chemist4u
{{- end }}
{{- end }}
{{- if .signGitCommits }}
[commit]
  gpgsign = true
{{- end }}
{{- if .devMachine }}
# Written by `gh auth setup-git`. The empty helper resets any inherited value so
# gh is the only one consulted.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
{{- end }}
