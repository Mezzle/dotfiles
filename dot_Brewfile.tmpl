{{ if .devMachine -}}
# Development machine specific packages
brew "awscli"
brew "bat"
brew "direnv"
brew "gh"
brew "jq"
brew "node"
brew "opencode"
brew "pipx"
# No `brew "pnpm"`: pnpm comes from `nub pm` via the ~/.nub/shims/pnpm shim, which
# provisions the exact version each project pins. A brew pnpm would shadow it.
brew "ripgrep"
brew "trufflehog"
brew "uv"
brew "yamllint"

cask "chatgpt"
# codexbar monitors Claude usage as well as Codex, so it outlives the Codex apps.
cask "codexbar"
cask "jetbrains-toolbox"
cask "linear"
cask "orbstack"
cask "rapidapi"
cask "visual-studio-code"

# The Claude desktop app only. Claude Code is not the `claude-code` cask: that channel
# never auto-updates, so .chezmoiscripts/run_onchange_before_03-install-claude-code.sh
# uses the self-updating native installer instead.
cask "claude"
{{- end }}

{{ if .signGitCommits -}}
# Packages for signing git commits
brew "gnupg"
brew "pinentry-mac"
{{- end }}

{{ if .gaming -}}
# Gaming machine specific packages
cask "es-de"
cask "retroarch-metal"
cask "steam"
{{- end }}
