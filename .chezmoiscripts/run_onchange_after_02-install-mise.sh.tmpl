{{- if .devMachine -}}
#!/bin/bash
set -euo pipefail

# Keep developer-tool installation with chezmoi rather than split between
# Homebrew, Nub, and per-host bootstrap scripts. This runs after the shared
# ~/.config/mise/config.toml has been deployed.
# Mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
if [[ ! -x "${HOME}/.local/bin/mise" ]]; then
    echo "Installing mise"
    curl -fsSL https://mise.run | sh
fi

# Both OpenCode packages provide `opencode`; remove V1 before installing V2.
"${HOME}/.local/bin/mise" uninstall --all npm:opencode-ai
"${HOME}/.local/bin/mise" install
{{- end }}
