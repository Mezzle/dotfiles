{{- if .devMachine -}}
#!/bin/bash
set -euo pipefail

# Keep developer-tool installation with chezmoi rather than split between
# Homebrew, Nub, and per-host bootstrap scripts. This runs after the shared
# ~/.config/mise/config.toml has been deployed.
if [[ ! -x "${HOME}/.local/bin/mise" ]]; then
    echo "Installing mise"
    curl -fsSL https://mise.run | sh
fi

"${HOME}/.local/bin/mise" install
{{- end }}
