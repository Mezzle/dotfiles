{{- if and .devMachine (eq .chezmoi.os "linux") -}}
#!/bin/bash
set -euo pipefail

# Restart only an already-installed T3 service when its Mise PATH drop-in
# changes. A later `t3 service install` also reads the drop-in automatically.
# T3 service PATH drop-in hash: {{ include "dot_config/systemd/user/t3code.service.d/mise-path.conf.tmpl" | sha256sum }}
if systemctl --user cat t3code.service >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user restart t3code.service
fi
{{- end }}
