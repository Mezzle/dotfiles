{{- if .devMachine -}}
#!/bin/bash
set -eu

# nub isn't in Homebrew, so it bootstraps itself. NUB_NO_MODIFY_PATH keeps the
# installer out of ~/.zshrc, which chezmoi owns; ~/.zshrc.d/99-nub.zsh sets PATH.
if [[ ! -x "${HOME}/.nub/bin/nub" ]]; then
    echo "Installing nub"
    NUB_NO_MODIFY_PATH=1 /bin/bash -c "$(curl -fsSL https://nubjs.com/install.sh)"
fi

# Two sets of shims: `node shim` puts a `node` on PATH that resolves through nub, and
# `pm shim` puts npm/pnpm/yarn there — the only pnpm on the machine, since the Brewfile
# deliberately has none. Both have to be rebuilt after `nub upgrade`. Each insists on
# appending its own PATH block to ~/.zshrc *and* ~/.zshenv, both of which chezmoi owns,
# so put those files back afterwards and let ~/.zshrc.d/99-nub.zsh do the job instead.
if [[ ! -x "${HOME}/.nub/node-shim/node" || ! -x "${HOME}/.nub/shims/pnpm" ||
      "${HOME}/.nub/bin/nub" -nt "${HOME}/.nub/node-shim/node" ||
      "${HOME}/.nub/bin/nub" -nt "${HOME}/.nub/shims/pnpm" ]]; then
    zshrc_backup=""
    if [[ -f "${HOME}/.zshrc" ]]; then
        zshrc_backup=$(mktemp)
        cp "${HOME}/.zshrc" "${zshrc_backup}"
    fi
    zshenv_backup=""
    if [[ -f "${HOME}/.zshenv" ]]; then
        zshenv_backup=$(mktemp)
        cp "${HOME}/.zshenv" "${zshenv_backup}"
    fi

    "${HOME}/.nub/bin/nub" node shim
    "${HOME}/.nub/bin/nub" pm shim

    if [[ -n "${zshrc_backup}" ]]; then
        mv "${zshrc_backup}" "${HOME}/.zshrc"
    fi
    if [[ -n "${zshenv_backup}" ]]; then
        mv "${zshenv_backup}" "${HOME}/.zshenv"
    fi
fi
{{- end -}}
