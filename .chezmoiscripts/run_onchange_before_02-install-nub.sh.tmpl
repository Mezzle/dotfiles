{{- if .devMachine -}}
#!/bin/bash
set -eu

# nub isn't in Homebrew, so it bootstraps itself. NUB_NO_MODIFY_PATH keeps the
# installer out of ~/.zshrc, which chezmoi owns; ~/.zshrc.d/99-nub.zsh sets PATH.
if [[ ! -x "${HOME}/.nub/bin/nub" ]]; then
    echo "Installing nub"
    NUB_NO_MODIFY_PATH=1 /bin/bash -c "$(curl -fsSL https://nubjs.com/install.sh)"
fi

# The shim puts a `node` on PATH that resolves through nub, and has to be rebuilt
# after `nub upgrade`. It insists on appending its own PATH block to ~/.zshrc, so
# put that file back afterwards and let ~/.zshrc.d/99-nub.zsh do the job instead.
if [[ ! -x "${HOME}/.nub/node-shim/node" || "${HOME}/.nub/bin/nub" -nt "${HOME}/.nub/node-shim/node" ]]; then
    zshrc_backup=""
    if [[ -f "${HOME}/.zshrc" ]]; then
        zshrc_backup=$(mktemp)
        cp "${HOME}/.zshrc" "${zshrc_backup}"
    fi

    "${HOME}/.nub/bin/nub" node shim

    if [[ -n "${zshrc_backup}" ]]; then
        mv "${zshrc_backup}" "${HOME}/.zshrc"
    fi
fi
{{- end -}}
