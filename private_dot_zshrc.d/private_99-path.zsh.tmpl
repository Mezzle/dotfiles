{{ if eq .chezmoi.os "darwin" -}}
export PATH="${BREW_PREFIX}/opt/grep/libexec/gnubin:${PATH}"
export PATH="${BREW_PREFIX}/opt/gnu-which/libexec/gnubin:${PATH}"
export PATH="${BREW_PREFIX}/opt/uutils-coreutils/libexec/uubin:${PATH}"
export PATH="${BREW_PREFIX}/opt/uutils-diffutils/libexec/uubin:${PATH}"
export MANPATH="${BREW_PREFIX}/opt/uutils-coreutils/libexec/uuman:${MANPATH}"
export MANPATH="${BREW_PREFIX}/opt/uutils-diffutils/libexec/uuman:${MANPATH}"

# auto: colour only when stdout is a terminal, so piped or captured output
# (scripts, agent tools) gets plain names rather than raw ANSI escapes.
alias ls="ls --color=auto"
disable which
{{ end -}}
